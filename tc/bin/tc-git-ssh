#!/usr/bin/env bash
# ==================================================================================================
# ThunderCast — tc-git-ssh (GIT_SSH_COMMAND entry; argv0 must be a real binary)
# ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
# Date:          Created: 2026-08-31 | Modified: 2026-08-31
# ==================================================================================================
set -euo pipefail

_TC_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -d "${_TC_BIN}/../lib" ]]; then
    TC_LIB="${TC_LIB:-$(cd "${_TC_BIN}/../lib" && pwd)}"
fi
[[ -n "${TC_LIB:-}" && -f "${TC_LIB}/tc_common.sh" ]] || {
    printf 'tc-git-ssh: cannot find lib/ (set TC_LIB)\n' >&2
    exit 1
}
# shellcheck disable=SC1091
source "${TC_LIB}/tc_common.sh"
# shellcheck disable=SC1091
source "${TC_LIB}/tc_git_ssh.sh"
tc_git_ssh_exec "$@"
