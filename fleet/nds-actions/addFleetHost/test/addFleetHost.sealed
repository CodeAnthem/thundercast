# nds-recipe 1
[cook]
LEAF_PUSH_DIR="@SESSION@/work/leaf"
LEAF_PUSH_MESSAGE="nds: new host webhost (role web)"
BUNDLE_SAVE_ON_TARGET="false"
[install]
INSTALL_MODE="local"
INSTALL_ACTION="addFleetHost"
[flake]
FLAKE_LOCATION="lab"
FLAKE_SOURCE="local"
FLAKE_LOCAL_PATH="@SESSION@/flake"
FLAKE_INSTALL_PATH="@SESSION@/mnt/etc/nixos"
FLAKE_HOST="webhost"
FLAKE_HOST_DIR="hosts/x86_64-linux"
FLAKE_HARDWARE_PLACEMENT="host-dir"
SOPS_AGE_REUSE="generate"
SOPS_AGE_KEY_FILE="@SESSION@/secrets/SOPS_AGE_KEY"
[git]
GIT_KEYS_DIR="@SESSION@/secrets/git"
GIT_PERSIST_ACCESS="true"
[scaffold]
SCAFFOLD_MODE="new"
SCAFFOLD_ROLE="web"
[network]
NETWORK_HOSTNAME="webhost"
NETWORK_METHOD="dhcp"
NETWORK_DNS_PRIMARY="1.1.1.1"
NETWORK_DNS_SECONDARY="1.0.0.1"
[boot]
BOOT_UEFI_MODE="false"
BOOT_LOADER="grub"
[disk]
DISK_TARGET="/dev/sda"
DISK_STRATEGY="nds"
[encryption]
ENCRYPTION="true"
ENCRYPTION_PASSWORD="true"
ENCRYPTION_KEY="false"
ENCRYPTION_REMOTE_UNLOCK="false"
ENCRYPTION_PASSWORD_AUTO="true"
ENCRYPTION_PASSWORD_LENGTH="64"
ENCRYPTION_PASSPHRASE_FILE="@SESSION@/secrets/ENCRYPTION_PASSPHRASE"
