# nds-recipe 1
[cook]
LEAF_PUSH_DIR="@SESSION@/work/leaf"
LEAF_PUSH_MESSAGE="nds: toolkit new host control-toolkit"
TARGET_SEED_DIR="@SESSION@/seed"
BUNDLE_SAVE_ON_TARGET="false"
[install]
INSTALL_MODE="local"
INSTALL_ACTION="toolkit"
[toolkit]
TOOLKIT_CLONE_URL="https://github.com/CodeAnthem/thundercast.git"
TOOLKIT_MODE="new"
TOOLKIT_AGE_KEY_FILE="@SESSION@/secrets/TOOLKIT_AGE_KEY"
TOOLKIT_SSH_KEY_FILE="@SESSION@/secrets/TOOLKIT_SSH_KEY"
[flake]
FLAKE_LOCATION="lab"
FLAKE_SOURCE="remote"
FLAKE_INSTALL_PATH="@SESSION@/mnt/etc/nixos"
FLAKE_HOST="control-toolkit"
FLAKE_HOST_DIR="hosts/x86_64-linux"
FLAKE_HARDWARE_PLACEMENT="host-dir"
SOPS_AGE_REUSE="generate"
SOPS_AGE_KEY_FILE="@SESSION@/secrets/SOPS_AGE_KEY"
[git]
GIT_KEYS_DIR="@SESSION@/secrets/git"
GIT_PERSIST_ACCESS="true"
[network]
NETWORK_HOSTNAME="control-toolkit"
NETWORK_METHOD="dhcp"
NETWORK_DNS_PRIMARY="1.1.1.1"
NETWORK_DNS_SECONDARY="1.0.0.1"
[access]
ACCESS_ADMIN_USER="admin"
ACCESS_ADMIN_PASSWORD_AUTO="true"
ACCESS_ADMIN_PASSWORD_LENGTH="32"
ACCESS_ADMIN_PASSWORD_FILE="@SESSION@/secrets/ACCESS_ADMIN_PASSWORD"
ACCESS_SUDO_PASSWORD_REQUIRED="true"
ACCESS_SSH_ENABLE="true"
ACCESS_SSH_PORT="22"
ACCESS_SSH_PASSWORD_AUTH="true"
[boot]
BOOT_UEFI_MODE="false"
BOOT_LOADER="grub"
[disk]
DISK_TARGET="/dev/sda"
DISK_STRATEGY="nds"
[encryption]
ENCRYPTION="true"
ENCRYPTION_PASSWORD="true"
ENCRYPTION_KEY="false"
ENCRYPTION_REMOTE_UNLOCK="false"
ENCRYPTION_PASSWORD_AUTO="true"
ENCRYPTION_PASSWORD_LENGTH="64"
ENCRYPTION_PASSPHRASE_FILE="@SESSION@/secrets/ENCRYPTION_PASSPHRASE"
[platform]
PLATFORM_RUN_ON_VM="false"
