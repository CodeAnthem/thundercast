# nds-recipe 1
[cook]
COOK_PHASES="disk stage_flake hardware_facter write_generated_host host_structure stage_host_files prefetch eval install_flake bootloader verify"
[install]
INSTALL_MODE="local"
[network]
NETWORK_HOSTNAME="host"
[access]
ACCESS_ADMIN_USER="admin"
[disk]
DISK_STRATEGY="flake"
[flake]
FLAKE_LOCATION="/var/flake"
FLAKE_SOURCE="local"
FLAKE_LOCAL_PATH="/var/flake"
FLAKE_HOST="control"
FLAKE_INSTALL_PATH="/mnt/etc/nixos"
