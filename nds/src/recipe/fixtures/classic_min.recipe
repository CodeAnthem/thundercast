# nds-recipe 1
[cook]
COOK_PHASES="disk write_classic hardware_nix copy_configs install_classic bootloader verify"
[install]
INSTALL_MODE=local
[region]
REGION_TIMEZONE="UTC"
REGION_LOCALE_MAIN="en_US.UTF-8"
[network]
NETWORK_HOSTNAME=host
NETWORK_METHOD="dhcp"
[access]
ACCESS_ADMIN_USER="admin"
[disk]
DISK_STRATEGY="nds"
DISK_TARGET="/dev/stubdisk"
