# Description:   BIOS GRUB on /dev/sda (NDS rewrites on install)
# ==================================================================================================

{ lib, ... }: {
  boot.loader.grub = {
    enable = lib.mkForce true;
    device = lib.mkForce "/dev/sda";
  };
}
